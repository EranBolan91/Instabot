# Copy this file to .env and fill it in. .env is ignored by git, so never commit real values.

# Error e-mails (Mailgun). All three are needed, or no e-mail is sent.
MAILGUN_DOMAIN=
MAILGUN_API=
ALERT_EMAIL=

# Proxy for bot_folder/proxy.py (get_proxy_plugin)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
