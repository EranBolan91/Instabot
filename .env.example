# Copy this file to .env and fill it in. .env is ignored by git, so never commit real values.

# Error e-mails (Mailgun). All three are needed, or no e-mail is sent.
MAILGUN_DOMAIN=
MAILGUN_API=
ALERT_EMAIL=

# Proxy for bot_folder/proxy.py (get_proxy_plugin)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Key that encrypts the saved Instagram passwords. Leave empty: the app makes one and keeps it in
# the system password store (or in instabot.key if there is none). Set it only to share one key
# between computers; make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTABOT_SECRET_KEY=
